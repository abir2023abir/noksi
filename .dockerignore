# Ignore files that bloat the Railway/Docker build context
.git
.github
.gitignore
.env
.env.*
!.env.example
node_modules
vendor
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php
.phpunit.cache
tests
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
README.md
